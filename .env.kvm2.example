# 8 GB VPS env (no Typesense / Tika). Copy on the server:
#   cp .env.kvm2.example .env.kvm2
# Then: docker compose -f docker-compose.kvm2.yml --env-file .env.kvm2 up -d --build

MYSQL_ROOT_PASSWORD=CHANGE_ME_long_random_mysql_password
JWT_SECRET=CHANGE_ME_at_least_32_characters_random_string
VAULT_ENCRYPTION_KEY=CHANGE_ME_another_32_char_minimum_secret

# Use your real domain (example):
CLIENT_URL=https://auditiq.mkdandeker.com
DOMAIN=auditiq.mkdandeker.com
# Optional — defaults to api.${DOMAIN} if DOMAIN is set
API_DOMAIN=api.auditiq.mkdandeker.com

# Before HTTPS, you can use:
# CLIENT_URL=http://auditiq.mkdandeker.com
# DOMAIN=
# API_DOMAIN=api.auditiq.mkdandeker.com

ALLOW_STAFF_REGISTRATION=false
SKIP_EMAIL_VERIFICATION=true
MAX_FILE_SIZE_MB=25
