// PRD Section 7.1: MySQL (MariaDB via XAMPP) for local & production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── RBAC: Configurable Roles & Permissions ───

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String  @id @default(uuid())
  module      String // dashboard, engagements, workpapers, documents, reports, attendance, copilot, settings
  action      String // view, create, edit, delete, approve, export
  description String?

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  initials         String
  role             String   @default("Staff") // Legacy field for JWT backward compat
  phone            String?
  designation      String? // CA Rajesh Sharma, Article Clerk, etc.
  isActive         Boolean  @default(true)
  presenceStatus   String   @default("online") // online | offline | maintenance | degraded
  presenceUpdatedAt DateTime?
  notifyStageChanges Boolean @default(true)
  notifyDocumentRequests Boolean @default(true)
  notifyInvoices     Boolean @default(true)
  notifyDailyDigest  Boolean @default(true)
  lastDigestSentAt   DateTime?
  twoFactorEnabled Boolean  @default(false)
  totpSecret       String?  @db.Text // AES-256-GCM encrypted TOTP secret
  refreshToken     String?  @db.Text // legacy plaintext (cleared on next login)
  refreshTokenHash String?  @unique // SHA-256 hash of the active refresh token
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  passwordResetTokenHash String?   @unique
  passwordResetExpires   DateTime?
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpires   DateTime?
  mustChangePassword         Boolean   @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // RBAC relation
  roleId  String?
  roleRef Role?   @relation(fields: [roleId], references: [id])

  // MKD office hierarchy (Partners → Audit Executives → Interns)
  hierarchyLevelId String?
  hierarchyLevel   HierarchyLevel? @relation(fields: [hierarchyLevelId], references: [id])

  // Employee hierarchy
  reportsToId  String?
  reportsTo    User?   @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  subordinates User[]  @relation("EmployeeHierarchy")

  // Relations
  firmId            String?
  firm              Firm?              @relation(fields: [firmId], references: [id])
  employeeProfile   EmployeeProfile?
  engagementMembers EngagementMember[]
  workpapers        Workpaper[]
  reviewComments    ReviewComment[]
  signoffs          SignOff[]
  documents         Document[]
  timeEntries       TimeEntry[]
  timesheetDays     TimesheetDay[]     @relation("TimesheetDayStaff")
  timesheetReviews  TimesheetDay[]     @relation("TimesheetDayReviewer")
  notifications     Notification[]
  navAttentionAcks  NavAttentionAck[]
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  leaveApprovals    LeaveRequest[]     @relation("LeaveApprover")
  auditLogs         AuditLog[]
  copilotMessages   CopilotMessage[]
  copilotSessions   CopilotSession[]
  clientQueriesAuthored ClientAuditQuery[] @relation("ClientQueryAuthor")
  clientQueriesAnswered ClientAuditQuery[] @relation("ClientQueryResponder")

  // Chat relations
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  chatReactions    ChatMessageReaction[]
  chatStars        ChatMessageStar[]

  // Approval relations
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions  ApprovalStep[]

  // Onboarding / Workflow / Time / Vault
  kycVerified          KycDocument[]            @relation("KycVerifier")
  stageHistoryActions  EngagementStageHistory[] @relation("StageActor")
  tasksAssigned        Task[]                   @relation("TaskAssignee")
  tasksCreated         Task[]                   @relation("TaskCreator")
  stipends             StipendRecord[]
  articleship          ArticleshipRecord?
  vaultViews           VaultAccessLog[]
  passwordVaultCreated PasswordVaultEntry[]     @relation("VaultCreator")
  recurringSchedulesCreated RecurringSchedule[] @relation("RecurringScheduleCreator")
  lateHoursClaims      LateHoursClaim[]         @relation("LateHoursClaimStaff")
  lateHoursReviews     LateHoursClaim[]         @relation("LateHoursClaimReviewer")
  deptVisitClaims      DeptVisitClaim[]         @relation("DeptVisitClaimStaff")
  deptVisitReviews     DeptVisitClaim[]         @relation("DeptVisitClaimReviewer")
  engagementTeamChanges Engagement[]            @relation("EngagementTeamChanger")
  udinIssued           UdinLog[]                @relation("UdinIssuer")
  invoicesCreated      Invoice[]                @relation("InvoiceCreator")
  clientStopwatches    ClientStopwatch[]
  staffWorkStatus      StaffWorkStatus?
  googleDriveConnection GoogleDriveConnection?

  documentTemplatesCreated DocumentTemplate[] @relation("TemplateCreator")
  templateSends            TemplateSend[]     @relation("TemplateSender")
  engagementLettersCreated EngagementLetter[] @relation("EngagementLetterCreator")

  compOffRequests          CompOffRequest[]   @relation("CompOffRequester")
  compOffManagerApprovals  CompOffRequest[]   @relation("CompOffManager")
  compOffHrCredits         CompOffRequest[]   @relation("CompOffHr")

  @@index([firmId])
  @@index([roleId])
  @@index([role])
  @@index([reportsToId])
}

model Firm {
  id             String   @id @default(uuid())
  name           String
  registrationNo String?
  pan            String?
  gstin          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  clients     Client[]
  engagements Engagement[]
  offices     Office[]
  clientRequests    ClientRequest[]
  documentTemplates DocumentTemplate[]
  lookupValues      FirmLookupValue[]
  compOffRequests   CompOffRequest[]
}

// ─── PRD 5.1: Engagement & Client Management ───

model Client {
  id                  String    @id @default(uuid())
  name                String
  legalName           String? // Full legal name (may differ from trading name)
  cin                 String? // Company Identification Number
  pan                 String?
  gstin               String?
  category            String? // Private Ltd, Public Ltd, LLP, Trust, Sole Prop
  industry            String?
  address             String?
  city                String?
  state               String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  turnover            String?
  isActive            Boolean   @default(true)
  // Onboarding fields
  status              String    @default("Prospect") // Active | Inactive | Prospect
  conflictOfInterest  Boolean   @default(false)
  conflictNotes       String?   @db.Text
  conflictCheckedById String?
  conflictCheckedAt   DateTime?
  onboardedAt         DateTime?
  folderPath          String? // Auto-created folder path /ClientName/Year/...
  recurringAutomationDisabled Boolean @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  firmId        String
  firm          Firm                 @relation(fields: [firmId], references: [id])
  engagements   Engagement[]
  contacts      ClientContact[]
  directors     ClientDirector[]
  documents     ClientDocument[]
  kycDocuments  KycDocument[]
  passwordVault PasswordVaultEntry[]
  invoices      Invoice[]
  portalUsers   ClientPortalUser[]
  commsLog      CommsLog[]
  auditQueries  ClientAuditQuery[]
  requests      ClientRequest[]
  templateSends TemplateSend[]
  engagementLetters EngagementLetter[]
  recurringSchedules RecurringSchedule[]
  governmentNotices  GovernmentNotice[]

  @@index([firmId])
  @@index([status])
}

model Engagement {
  id                 String    @id @default(uuid())
  title              String
  type               String // Statutory | Tax (44AB) | GST | Internal | Special
  financialYear      String // e.g., 2024-25
  status             String    @default("Planning") // Planning | Fieldwork | Under Review | Reporting | Closed
  progress           Int       @default(0)
  scope              String?   @db.Text
  scopeIncluded      String?   @db.Text // EL: included items
  scopeExcluded      String?   @db.Text // EL: excluded items
  startDate          DateTime?
  deadline           DateTime?
  billingType        String? // Fixed | Hourly | Retainer
  billingAmount      Float?
  notes              String?   @db.Text
  // Workflow — DT / IDT / AUDIT templates (see workflowCatalog)
  workflowDomain     String?   // DT | IDT | AUDIT
  serviceCode        String?   // TDS_REMITTANCE, GSTR_1, STATUTORY_AUDIT, etc.
  // Workflow stage tracking
  currentStage       String    @default("Data Pending") // Template step label or legacy audit stage
  udin               String? // Unique Document Identification Number — required before Filed
  filedAt            DateTime?
  filingReferenceNo  String?
  filingAcknowledgmentNo String?
  filingAckPath      String?
  archivedAt         DateTime?
  // Engagement Letter (legacy PDF fields + MKD letter workflow)
  elGenerated        Boolean   @default(false)
  elSignedAt         DateTime?
  elSignedById       String?
  elStoragePath      String? // Path to generated EL PDF
  letterStatus       String    @default("not_required") // not_required | draft | sent | signed | rejected
  // MKD request / recurring metadata
  requestStatus      String?   // request_pending | request_approved | awaiting_letter_signature | team_assigned | in_progress | filed | completed | rejected
  isRecurring        Boolean   @default(false)
  recurringFrequency String?   // monthly | quarterly | yearly
  period             String?   // e.g. June 2026
  parentEngagementId String?
  parentEngagement   Engagement?  @relation("RecurringEngagements", fields: [parentEngagementId], references: [id])
  childEngagements   Engagement[] @relation("RecurringEngagements")
  clientRequestId    String?
  clientRequest      ClientRequest? @relation(fields: [clientRequestId], references: [id])
  // Resource allocation
  partnerInChargeId  String?
  managerId          String?
  articleAssistantId String?
  teamLastChangedById String?
  teamLastChangedAt   DateTime?
  teamLastChangedBy   User?    @relation("EngagementTeamChanger", fields: [teamLastChangedById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])
  firmId   String
  firm     Firm   @relation(fields: [firmId], references: [id])

  members          EngagementMember[]
  workpapers       Workpaper[]
  documents        Document[]
  documentRequests DocumentRequest[]
  observations     Observation[]
  signoffs         SignOff[]
  timeEntries      TimeEntry[]
  reports          Report[]
  copilotSessions  CopilotSession[]
  deadlines        Deadline[]
  stageHistory     EngagementStageHistory[]
  checklistItems   DataChecklistItem[]
  tasks            Task[]
  invoices         Invoice[]
  udinEntries      UdinLog[]
  commsLog         CommsLog[]
  auditQueries     ClientAuditQuery[]
  periods          EngagementPeriod[]
  engagementLetter EngagementLetter?
  templateSends    TemplateSend[]
  governmentNotices GovernmentNotice[]
  lateHoursClaims  LateHoursClaim[]
  deptVisitClaims  DeptVisitClaim[]

  @@index([clientId])
  @@index([firmId])
  @@index([status])
  @@index([currentStage])
  @@index([workflowDomain])
  @@index([serviceCode])
  @@index([partnerInChargeId])
  @@index([managerId])
  @@index([articleAssistantId])
  @@index([letterStatus])
  @@index([requestStatus])
  @@index([parentEngagementId])
  @@index([clientRequestId])
  @@index([teamLastChangedById])
}

// ─── MKD: Client service requests (before engagement activation) ───

model ClientRequest {
  id               String    @id @default(uuid())
  selectedServices Json      // string[] of service codes
  financialYears   Json      // string[]
  notes            String?   @db.Text
  status           String    @default("pending") // pending | approved | rejected
  submittedAt      DateTime  @default(now())
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?   @db.Text

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firmId   String
  firm     Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  engagements Engagement[]

  @@index([clientId])
  @@index([firmId])
  @@index([status])
}

// ─── MKD: Document template library ───

model DocumentTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String   // engagement_letter | data_request | reminder | etc.
  serviceTypes Json?    // string[] — which services apply
  subject      String
  body         String   @db.LongText
  attachPdf    Boolean  @default(false)
  variables    Json?    // string[] — {{VAR}} names
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firmId      String
  firm        Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?  @relation("TemplateCreator", fields: [createdById], references: [id])
  sends       TemplateSend[]
  letters     EngagementLetter[]

  @@index([firmId])
  @@index([category])
  @@index([isActive])
}

model TemplateSend {
  id            String   @id @default(uuid())
  filledSubject String?
  filledContent String   @db.LongText
  sentAt        DateTime @default(now())
  deliveryStatus String  @default("sent") // sent | delivered | failed

  templateId   String
  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?      @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  sentById     String
  sentBy       User             @relation("TemplateSender", fields: [sentById], references: [id])

  @@index([templateId])
  @@index([clientId])
  @@index([engagementId])
  @@index([sentAt])
}

model EngagementLetter {
  id                String    @id @default(uuid())
  subjectLine       String?   @db.Text
  generatedContent  String?   @db.LongText
  docxPath          String?   // draft/sent Word document on disk
  pdfPath           String?   // legacy — unused
  status            String    @default("draft") // draft | sent | signed | rejected
  fees              Json?     // FeeLineItem[]
  partnerName       String?
  partnerDesignation String?  @default("Partner")
  sentAt            DateTime?
  signedAt          DateTime?
  signedDocumentUrl String?   // final signed DOCX path
  clientSignatoryName String?
  signatureImagePath  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  engagementId String     @unique
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User       @relation("EngagementLetterCreator", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([templateId])
}

model ClientAuditQuery {
  id           String   @id @default(uuid())
  subject      String
  body         String   @db.Text
  status       String   @default("Open") // Open | Answered | Closed
  response     String?  @db.Text
  respondedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User       @relation("ClientQueryAuthor", fields: [createdById], references: [id])
  respondedById String?
  respondedBy   User?      @relation("ClientQueryResponder", fields: [respondedById], references: [id])

  @@index([engagementId])
  @@index([clientId])
  @@index([status])
}

model EngagementMember {
  id         String   @id @default(uuid())
  role       String   @default("Preparer") // Lead | Reviewer | Preparer (legacy)
  teamRole   String?  // Manager | Staff | Partner
  sortOrder  Int      @default(0) // Priority within teamRole (0 = primary)
  assignedAt DateTime @default(now())

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  @@unique([engagementId, userId])
  @@index([userId])
  @@index([teamRole])
}

// ─── PRD 5.2: Document & Evidence Management ───

model Document {
  id             String   @id @default(uuid())
  fileName       String
  originalName   String
  mimeType       String
  size           Int
  storagePath    String
  category       String? // Bank Statement | Invoice | Ledger | TDS Cert | Other
  folder         String   @default("Current File") // Permanent File | Current File | Correspondence | Reports
  version        Int      @default(1)
  parentId       String? // For version tracking — points to previous version
  isOcrProcessed Boolean  @default(false)
  ocrText        String?  @db.LongText
  source         String   @default("UPLOAD") // UPLOAD | GOOGLE_DRIVE
  externalId     String? // Google Drive file id
  visibility     String   @default("ENGAGEMENT") // ENGAGEMENT | FIRM
  firmId         String?
  clientId       String?
  indexStatus    String   @default("PENDING") // PENDING | INDEXED | FAILED | SKIPPED
  indexedAt      DateTime?
  driveModifiedAt DateTime?
  syncedAt       DateTime?
  createdAt      DateTime @default(now())

  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  workpaperId  String?
  workpaper    Workpaper? @relation(fields: [workpaperId], references: [id])
  checklistItems DataChecklistItem[]

  @@unique([firmId, externalId])
  @@index([engagementId])
  @@index([uploadedById])
  @@index([workpaperId])
  @@index([firmId])
  @@index([visibility])
  @@index([indexStatus])
}

model GoogleDriveConnection {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId                String
  googleEmail           String?
  encryptedRefreshToken String    @db.Text
  encryptedAccessToken  String?   @db.Text
  accessTokenExpiresAt  DateTime?
  folderIds             String?   @db.Text // JSON string[] of Drive folder ids to sync
  defaultEngagementId   String?
  lastSyncAt            DateTime?
  startPageToken        String? // Drive changes API cursor
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([firmId])
}

model DocumentRequest {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  status      String    @default("Pending") // Pending | Received | Rejected | Overdue
  dueDate     DateTime?
  clientNotes String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
}

// ─── PRD 5.3: Audit Workpapers & Fieldwork ───

model Workpaper {
  id         String   @id @default(uuid())
  reference  String // e.g., WP-01, WP-02
  title      String
  section    String // Revenue | Expenses | Fixed Assets | Bank | Payroll | etc.
  type       String   @default("Standard") // Standard | CARO | SA | GST | TDS | Lead Schedule
  content    String?  @db.LongText // Rich text / JSON content of the workpaper
  status     String   @default("Draft") // Draft | Prepared | Under Review | Reviewed | Approved | Needs Revision
  conclusion String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  preparedById String
  preparedBy   User       @relation(fields: [preparedById], references: [id])

  auditSteps     AuditStep[]
  reviewComments ReviewComment[]
  documents      Document[]
  signoffs       SignOff[]

  @@index([engagementId])
  @@index([preparedById])
}

model AuditStep {
  id          String   @id @default(uuid())
  stepNumber  Int
  description String   @db.Text
  procedure   String?  @db.Text
  isCompleted Boolean  @default(false)
  result      String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workpaperId String
  workpaper   Workpaper @relation(fields: [workpaperId], references: [id])

  @@index([workpaperId])
}

// ─── PRD 5.4: Review & Approval Workflow ───

model ReviewComment {
  id         String   @id @default(uuid())
  content    String   @db.Text
  isResolved Boolean  @default(false)
  parentId   String? // For threaded replies
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workpaperId String
  workpaper   Workpaper @relation(fields: [workpaperId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  @@index([workpaperId])
  @@index([authorId])
}

model SignOff {
  id        String    @id @default(uuid())
  type      String // Preparer | Manager | Partner
  status    String    @default("Pending") // Pending | Approved | Rejected
  comments  String?   @db.Text
  signedAt  DateTime?
  createdAt DateTime  @default(now())

  workpaperId  String?
  workpaper    Workpaper?  @relation(fields: [workpaperId], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])

  @@index([workpaperId])
  @@index([engagementId])
  @@index([userId])
}

// ─── PRD 5.5: Reporting & Output Generation ───

model Observation {
  id                 String   @id @default(uuid())
  title              String
  severity           String   @default("Moderate") // Critical | Moderate | Low
  criteria           String?  @db.Text // What should be (the standard)
  condition          String?  @db.Text // What is (the finding)
  cause              String?  @db.Text
  effect             String?  @db.Text
  recommendation     String?  @db.Text
  managementResponse String?  @db.Text
  status             String   @default("Open") // Open | Resolved | Disputed
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
}

model Report {
  id          String   @id @default(uuid())
  type        String // Statutory Audit | Tax Audit (3CD) | Management Letter | LLP | Trust | Custom
  title       String
  content     String?  @db.LongText // JSON or rich text content of the report
  status      String   @default("Draft") // Draft | Under Review | Final | Signed
  version     Int      @default(1)
  sharedWithClient Boolean @default(false)
  sharedWithClientAt DateTime?
  clientAcknowledgedAt DateTime?
  clientAcknowledgedById String?
  clientQueryText String? @db.Text
  clientQueryAt DateTime?
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  form3cdData Form3CDClause[]

  @@index([engagementId])
}

model Form3CDClause {
  id           String  @id @default(uuid())
  clauseNumber Int
  clauseTitle  String
  response     String? @db.Text
  remarks      String? @db.Text
  isApplicable Boolean @default(true)
  isCompleted  Boolean @default(false)

  reportId String
  report   Report @relation(fields: [reportId], references: [id])

  @@index([reportId])
}

// ─── PRD 5.6: Time, Billing & Practice Management ───

model TimeEntry {
  id          String    @id @default(uuid())
  date        DateTime
  hours       Float
  workType    String? // Audit | GST Filing | IT Filing | Consultation | Internal | Other
  stage       String? // engagement pipeline stage at time of logging
  description String?   @db.Text
  notes       String?   @db.Text
  isBillable  Boolean   @default(true)
  source      String    @default("manual") // manual | stopwatch
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  taskId       String?
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([engagementId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

/// Daily timesheet attestation (CA firm: Manager / Sr Exec signs off hours before WIP/billing).
model TimesheetDay {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("TimesheetDayStaff", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  /// Draft | Submitted | Approved | Rejected
  status       String    @default("Draft")
  submittedAt  DateTime?
  reviewedById String?
  reviewer     User?     @relation("TimesheetDayReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@index([status])
  @@index([date])
}

model Deadline {
  id         String   @id @default(uuid())
  title      String
  type       String // Statutory | Tax | GST | Internal | MCA
  dueDate    DateTime
  status     String   @default("On Track") // On Track | At Risk | Overdue | Completed
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
}

// ─── PRD 5.7: Notifications ───

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  type      String   @default("info") // info | warning | success | danger
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

/** When a user views a nav area, badges for that scope clear until new activity arrives. */
model NavAttentionAck {
  userId  String
  scope   String
  ackedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
}

// ─── PRD 5.8: Facial Recognition Attendance Module ───

model Office {
  id             String  @id @default(uuid())
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  geofenceRadius Int     @default(500) // meters

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id])

  attendances Attendance[]

  @@index([firmId])
}

model Attendance {
  id        String    @id @default(uuid())
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("present") // present | late | absent | leave | half-day | wfh-pending
  totalActiveSeconds Int @default(0)
  totalAwaySeconds   Int @default(0)
  /// Office | Client Place | Work from Home (HR place-of-work)
  location  String?
  /// on_time | soft_late | hard_late — Article late bands (IST)
  lateBand  String?
  clientName String?
  /// null = Bio not synced; true/false after Bio import / HR mark
  bioPresent Boolean?
  /// Same-month mail exception (HR forgive)
  forgiven Boolean @default(false)
  forgivenReason String?
  forgivenById String?
  wfhApprovedById String?
  gpsLat    Float?
  gpsLng    Float?
  /// Browser/device reported GPS accuracy in meters (Office check-in)
  gpsAccuracy Float?
  method    String    @default("face") // face | otp | manual | timer | manual-login
  createdAt DateTime  @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  @@index([userId])
  @@index([officeId])
  @@index([userId, date])
}

/// Manager pre-approval required before Article WFH check-in (HR).
model WfhApproval {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime
  approvedById String
  note         String?
  createdAt    DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

/// Firm master lists for Attendance / Timesheet (HR client names, activity classification, holidays).
model FirmLookupValue {
  id        String   @id @default(uuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// attendance_client | activity_classification | firm_holiday (YYYY-MM-DD)
  kind      String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([firmId, kind, value])
  @@index([firmId, kind])
}

/// Article comp-off: Sunday / firm holiday work → Manager/Partner approve → HR credit leave.
model CompOffRequest {
  id                   String    @id @default(uuid())
  firmId               String
  firm                 Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation("CompOffRequester", fields: [userId], references: [id], onDelete: Cascade)
  workDate             DateTime
  days                 Float     @default(1)
  reason               String?   @db.Text
  /// Pending | ManagerApproved | HrCredited | Rejected
  status               String    @default("Pending")
  managerApprovedById  String?
  managerApprover      User?     @relation("CompOffManager", fields: [managerApprovedById], references: [id], onDelete: SetNull)
  managerApprovedAt    DateTime?
  hrCreditedById       String?
  hrCreditor           User?     @relation("CompOffHr", fields: [hrCreditedById], references: [id], onDelete: SetNull)
  hrCreditedAt         DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  rejectionReason      String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([firmId, status])
  @@index([userId])
  @@index([workDate])
}

model LeaveRequest {
  id                String    @id @default(uuid())
  type              String // Casual | Sick | Earned | Holiday | Exam (Foundation/Intermediate/Final) | Study
  examLevel         String? // For Exam leaves: Foundation | Intermediate | Final
  fromDate          DateTime
  toDate            DateTime
  days              Int
  reason            String?   @db.Text
  // Two-step approval: Manager then Partner
  status            String    @default("Pending") // Pending | Manager Approved | Approved | Rejected
  managerApprovedAt DateTime?
  managerApprovedBy String?
  partnerApprovedAt DateTime?
  partnerApprovedBy String?
  rejectedAt        DateTime?
  rejectedBy        String?
  rejectionReason   String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId     String
  user       User    @relation(fields: [userId], references: [id])
  approverId String?
  approver   User?   @relation("LeaveApprover", fields: [approverId], references: [id])

  @@index([userId])
  @@index([approverId])
  @@index([status])
}

// ─── PRD 6: AI Copilot ───

model CopilotSession {
  id        String   @id @default(uuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  messages CopilotMessage[]

  @@index([userId])
  @@index([engagementId])
}

model CopilotMessage {
  id          String   @id @default(uuid())
  role        String // user | assistant
  content     String   @db.LongText
  citations   String?  @db.Text // JSON array of source citations
  wasAccepted Boolean? // For AI outputs: accepted/edited/rejected tracking
  createdAt   DateTime @default(now())

  sessionId String
  session   CopilotSession @relation(fields: [sessionId], references: [id])
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

// ─── PRD 7.2: Full audit log ───

model AuditLog {
  id        String   @id @default(uuid())
  action    String // CREATE | UPDATE | DELETE | LOGIN | SIGNOFF | AI_USAGE
  entity    String // User | Client | Engagement | Workpaper | Document | etc.
  entityId  String?
  details   String?  @db.LongText // JSON with change details
  ipAddress String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}

// ─── Employee Statutory Data ───

model EmployeeProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal
  dateOfBirth   DateTime?
  gender        String? // Male | Female | Other
  bloodGroup    String?
  maritalStatus String?
  fatherName    String?

  // Identity documents
  pan        String?
  aadhaar    String? // Stored encrypted
  passportNo String?
  uanNumber  String? // Universal Account Number (EPF)

  // Address
  currentAddress   String? @db.Text
  currentCity      String?
  currentState     String?
  currentPincode   String?
  permanentAddress String? @db.Text
  permanentCity    String?
  permanentState   String?
  permanentPincode String?

  // Bank details
  bankName      String?
  bankBranch    String?
  accountNumber String? // Stored encrypted
  ifscCode      String?

  // Emergency contact
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  // Employment
  joiningDate    DateTime?
  department     String?
  employeeCode   String?
  employmentType String? // Full-time | Part-time | Contract | Intern
  probationEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryStructure   SalaryStructure?
  employeeDocuments EmployeeDocument[]
}

model SalaryStructure {
  id                String          @id @default(uuid())
  employeeProfileId String          @unique
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  basicSalary      Float @default(0)
  hra              Float @default(0)
  da               Float @default(0)
  specialAllowance Float @default(0)
  conveyance       Float @default(0)
  medicalAllowance Float @default(0)
  otherAllowances  Float @default(0)

  // Deductions
  pf              Float @default(0) // Employee PF contribution
  esi             Float @default(0)
  professionalTax Float @default(0)
  tds             Float @default(0)
  otherDeductions Float @default(0)

  ctc           Float    @default(0) // Cost to company (annual)
  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeDocument {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  docType      String // PAN Card | Aadhaar | Passport | Offer Letter | Relieving Letter | Payslip | Other
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  uploadedAt   DateTime @default(now())

  @@index([employeeProfileId])
}

// ─── Client Statutory Data (Extended) ───

model ClientContact {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false)
  department  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientDirector {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  din             String? // Director Identification Number
  name            String
  designation     String? // Managing Director | Director | Independent Director | Whole-time Director
  pan             String?
  aadhaar         String?
  email           String?
  phone           String?
  appointmentDate DateTime?
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientDocument {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  docType       String // COI | MOA | AOA | PAN Card | GST Certificate | Board Resolution | Financial Statement | Other
  fileName      String
  originalName  String
  mimeType      String
  size          Int
  storagePath   String
  financialYear String? // For financial statements
  uploadedAt    DateTime @default(now())

  @@index([clientId])
}

// ─── Generic Approval Workflow Engine ───

model ApprovalWorkflow {
  id          String  @id @default(uuid())
  name        String // e.g., "Leave Approval", "Document Sign-off", "Expense Approval"
  entityType  String // leave | document | expense | workpaper | engagement
  description String?
  isActive    Boolean @default(true)
  firmId      String

  steps    ApprovalWorkflowStep[]
  requests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
  @@index([entityType])
}

model ApprovalWorkflowStep {
  id         String           @id @default(uuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepOrder        Int
  approverRole     String? // Role name: Partner | Manager | Staff
  approverUserId   String? // Specific user, or null for role-based
  autoEscalateDays Int? // Auto-escalate after N days

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

model ApprovalRequest {
  id         String           @id @default(uuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  entityType  String // leave | document | expense | workpaper
  entityId    String // ID of the entity being approved
  title       String
  description String? @db.Text
  status      String  @default("Pending") // Pending | In Progress | Approved | Rejected | Escalated
  currentStep Int     @default(1)
  priority    String  @default("Normal") // Low | Normal | High | Urgent

  requesterId String
  requester   User   @relation("ApprovalRequester", fields: [requesterId], references: [id])

  steps ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([requesterId])
  @@index([entityType, entityId])
  @@index([status])
}

model ApprovalStep {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder Int
  status    String    @default("Pending") // Pending | Approved | Rejected | Skipped
  comments  String?   @db.Text
  actionAt  DateTime?

  approverId String?
  approver   User?   @relation(fields: [approverId], references: [id])

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([approverId])
}

// ─── Chat & Messaging System ───

model ChatRoom {
  id           String  @id @default(uuid())
  name         String? // null for DMs
  type         String  @default("direct") // direct | group | engagement
  description  String?
  engagementId String? // Link to engagement for engagement chats
  isArchived   Boolean @default(false)

  participants   ChatParticipant[]
  messages       ChatMessage[]
  pinnedMessages ChatPinnedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
  @@index([type])
}

model ChatParticipant {
  id     String   @id @default(uuid())
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id])

  role       String   @default("member") // admin | member
  lastReadAt DateTime @default(now())
  isMuted    Boolean  @default(false)
  isPinned   Boolean  @default(false) // Pin conversation in list (WhatsApp-style)
  isArchived Boolean  @default(false) // Archive for this participant only
  joinedAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id       String   @id @default(uuid())
  roomId   String
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId String
  sender   User     @relation(fields: [senderId], references: [id])

  content          String  @db.Text
  messageType      String  @default("text") // text | file | system
  fileName         String?
  fileOriginalName String?
  fileMimeType     String?
  fileSize         Int?
  fileData         Bytes?  @db.LongBlob

  parentId  String? // Reply to a message
  forwardedFromMessageId String?
  forwardedFromSenderName String?
  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         ChatMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("MessageReplies")
  pinnedMessages ChatPinnedMessage[]
  reactions      ChatMessageReaction[]
  stars          ChatMessageStar[]

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([parentId])
}

model ChatMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  emoji     String // thumbsup | check | question

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model ChatMessageStar {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  roomId    String

  starredAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([roomId])
}

model ChatPinnedMessage {
  id        String      @id @default(uuid())
  roomId    String
  room      ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime    @default(now())

  @@unique([roomId, messageId])
  @@index([roomId])
}

// ─── Document Sharing (File Management Enhancement) ───

model DocumentShare {
  id               String    @id @default(uuid())
  documentId       String
  shareToken       String    @unique @default(uuid())
  sharedById       String
  sharedWithEmail  String? // Email for external shares
  sharedWithUserId String? // For internal shares
  permission       String    @default("view") // view | download | edit
  password         String? // Optional password protection (hashed)
  expiresAt        DateTime?
  accessCount      Int       @default(0)
  maxAccess        Int? // Max number of times link can be accessed
  isActive         Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([sharedById])
  @@index([shareToken])
}

// ─── Client Onboarding: KYC Documents Checklist ───

model KycDocument {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  docType      String // PAN | GST Certificate | CIN | MOA | AOA | Address Proof | Board Resolution | Other
  status       String    @default("Pending") // Pending | Received | Verified
  storagePath  String? // Optional file path if uploaded
  fileName     String?
  notes        String?   @db.Text
  receivedAt   DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("KycVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ─── Workflow Stage History ───

model EngagementStageHistory {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  fromStage String?
  toStage   String
  notes     String? @db.Text
  actorId   String
  actor     User    @relation("StageActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([engagementId])
  @@index([actorId])
}

// ─── Data Checklist per Engagement ───

model DataChecklistItem {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  title          String
  description    String?   @db.Text
  status         String    @default("Requested") // Requested | Received | Missing | Revision Required
  requestedAt    DateTime  @default(now())
  receivedAt     DateTime?
  lastFollowupAt DateTime?
  followupCount  Int       @default(0)
  escalatedAt    DateTime?
  documentId     String?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  revisionNotes  String?   @db.Text
  revisionRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
  @@index([status])
  @@index([documentId])
}

// ─── Tasks (Today's To-Do) ───

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?   @db.Text
  priority         String    @default("Normal") // Low | Normal | High | Urgent
  status           String    @default("not_started") // not_started | in_progress | completed | blocked (+ legacy Open/In Progress/Done)
  dueDate          DateTime?
  proposedTimeline String?
  estimatedHours   Float?
  notes            String?   @db.Text
  completedAt      DateTime?

  assigneeId   String
  assignee     User        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    User        @relation("TaskCreator", fields: [createdById], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])
  timeEntries  TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  // engagementId indexed by Task_engagementId_fkey — do not add @@index([engagementId]) (db push conflict)
}

// ─── Live Client Stopwatch (open timers per user) ───

model ClientStopwatch {
  id           String   @id @default(uuid())
  userId       String   @unique // one open timer per user
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagementId String
  taskId       String?
  workType     String   @default("Audit")
  stage        String?
  startedAt    DateTime @default(now())
  isPaused     Boolean  @default(false)
  pausedAt     DateTime?
  notes        String?  @db.Text

  @@index([userId])
  @@index([taskId])
}

// Live work activity — engagement timer + idle detection (admin dashboard)
model StaffWorkStatus {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityStatus      String    @default("offline") // active | away | offline
  currentEngagementId String?
  currentStage        String?
  timerStartedAt      DateTime?
  lastActiveAt        DateTime?
  awaySince           DateTime?
  statusChangedAt     DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([activityStatus])
}

// ─── Stipend Tracking (ICAI Articleship) ───

model StipendRecord {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month       Int // 1-12
  year        Int
  articleYear Int // 1 | 2 | 3 (year of articleship)
  amount      Float
  status      String    @default("Pending") // Pending | Paid
  paidAt      DateTime?
  notes       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([status])
}

model ArticleshipRecord {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationNo  String?
  startDate       DateTime
  expectedEndDate DateTime
  actualEndDate   DateTime?
  // ICAI leave allowances (consumed counters)
  examLeaveUsed   Int       @default(0) // out of 175 days
  casualLeaveUsed Int       @default(0)
  sickLeaveUsed   Int       @default(0)
  /// Firm allotted leave for Article Assistants (HR: 24 days / 2 years)
  firmLeaveCredit Float     @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Password Vault (encrypted at rest) ───

model PasswordVaultEntry {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  portalName  String // Income Tax | GST | MCA | TAN | TRACES | Other
  username    String
  // AES-256-GCM encrypted password — stored as base64(iv:authTag:ciphertext)
  passwordEnc String  @db.Text
  notes       String? @db.Text
  lastSyncedAt DateTime?

  createdById String
  createdBy   User             @relation("VaultCreator", fields: [createdById], references: [id])
  accessLog   VaultAccessLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model VaultAccessLog {
  id      String             @id @default(uuid())
  entryId String
  entry   PasswordVaultEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  action    String  @default("view") // view | reveal | edit | delete
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([userId])
}

// ─── UDIN Log ───

model UdinLog {
  id           String      @id @default(uuid())
  udin         String      @unique
  caName       String // CA who generated
  caUserId     String
  caUser       User        @relation("UdinIssuer", fields: [caUserId], references: [id])
  clientId     String
  documentType String // Tax Audit | Statutory Audit | GST Annual Return | Certification | Other
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])
  generatedAt  DateTime    @default(now())
  status       String      @default("Active") // Active | Revoked
  revokedAt    DateTime?
  revokeReason String?     @db.Text

  @@index([clientId])
  @@index([engagementId])
  @@index([status])
}

// ─── Invoices & Payments ───

model Invoice {
  id           String      @id @default(uuid())
  invoiceNo    String      @unique
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  amount      Float
  tax         Float    @default(0) // GST amount
  totalAmount Float
  currency    String   @default("INR")
  description String?  @db.Text
  issueDate   DateTime @default(now())
  dueDate     DateTime
  status      String   @default("Unpaid") // Unpaid | Partial | Paid | Overdue | Cancelled
  paidAmount  Float    @default(0)

  createdById String
  createdBy   User   @relation("InvoiceCreator", fields: [createdById], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([engagementId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Float
  method    String? // Cash | Bank Transfer | UPI | Cheque
  reference String? // Txn ID, cheque no, etc.
  paidAt    DateTime @default(now())
  notes     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ─── Client Portal Users (separate from staff users) ───

model ClientPortalUser {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String? @unique

  email        String    @unique
  passwordHash String
  fullName     String
  mobile       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String?   @db.Text

  otps OtpVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OtpVerification {
  id                 String            @id @default(uuid())
  clientPortalUserId String?
  clientPortalUser   ClientPortalUser? @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  mobile     String?
  email      String?
  purpose    String // e-verification | login | password-reset
  otpHash    String // hashed OTP
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  reference  String? // engagementId or other reference

  createdAt DateTime @default(now())

  @@index([clientPortalUserId])
  @@index([purpose])
}

// ─── Communications Log (emails sent) ───

model CommsLog {
  id           String      @id @default(uuid())
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  channel      String    @default("email") // email | sms | inapp
  templateKey  String // welcome | document-followup | deadline-reminder | filing-confirmation | other
  toAddress    String
  ccAddress    String?
  subject      String
  body         String    @db.LongText
  status       String    @default("queued") // queued | sent | failed
  errorMessage String?   @db.Text
  sentAt       DateTime?
  metadata     String?   @db.Text // JSON

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([engagementId])
  @@index([status])
  @@index([templateKey])
}

// ─── MKD office hierarchy & workflow periods ───

model HierarchyLevel {
  id         String   @id @default(uuid())
  code       String   @unique
  title      String
  sortOrder  Int
  systemRole String   // Partner | Manager | Staff | Intern — permission mapping
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  users User[]

  @@index([sortOrder])
}

model EngagementPeriod {
  id           String   @id @default(uuid())
  periodKey    String   // e.g. 2026-05 for May 2026 GSTR-1
  label        String
  dueDate      DateTime?
  currentStage String   @default("Data Request")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, periodKey])
  @@index([engagementId])
}

// ─── Per-client recurring schedule config ───

model RecurringSchedule {
  id                        String    @id @default(uuid())
  engagementTemplateId      String    // serviceCode e.g. GSTR_1
  clientId                  String
  client                    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isActive                  Boolean   @default(true)
  frequency                 String    // monthly | quarterly | yearly
  triggerDay                Int?
  triggerDates              String?   @db.Text // JSON array for quarterly
  triggerMonth              String?
  autoCreateStartDate       DateTime
  autoCreateEndDate         DateTime?
  autoSendDataRequestLetter Boolean   @default(true)
  lastCreatedAt             DateTime?
  nextCreateAt              DateTime?
  createdById               String
  createdBy                 User      @relation("RecurringScheduleCreator", fields: [createdById], references: [id])
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([clientId, engagementTemplateId])
  @@index([clientId])
  @@index([isActive])
  @@index([nextCreateAt])
}

// ─── Staff claims ───

model LateHoursClaim {
  id                    String    @id @default(uuid())
  staffId               String
  staff                 User      @relation("LateHoursClaimStaff", fields: [staffId], references: [id])
  date                  DateTime  @db.Date
  normalEndTime         String    // HH:mm
  actualEndTime         String
  computerLogoffTime    String?
  fingerprintLogoffTime String?
  hoursOvertime         Float
  reason                String    @db.Text
  engagementId          String?
  engagement            Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  status                String    @default("pending") // pending | approved | rejected
  reviewedById          String?
  reviewedBy            User?     @relation("LateHoursClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  managerNotes          String?   @db.Text
  createdAt             DateTime  @default(now())

  @@index([staffId])
  @@index([status])
  @@index([date])
}

model DeptVisitClaim {
  id                String    @id @default(uuid())
  staffId           String
  staff             User      @relation("DeptVisitClaimStaff", fields: [staffId], references: [id])
  date              DateTime  @db.Date
  department        String    // GST_office | Income_Tax | TRACES | ROC | Other
  departmentDetails String    @db.Text
  purpose           String    @db.Text
  engagementId      String
  engagement        Engagement @relation(fields: [engagementId], references: [id])
  travelExpense     Float?
  receiptUrl        String?
  departureTime     String
  returnTime        String
  status            String    @default("pending")
  reviewedById      String?
  reviewedBy        User?     @relation("DeptVisitClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  managerNotes      String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([staffId])
  @@index([status])
  @@index([engagementId])
}

// ─── Government portal notices ───

model GovernmentNotice {
  id                String    @id @default(uuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portal            String    // GST | Income_Tax | TRACES
  noticeType        String
  adjudicationLevel String?
  referenceNumber   String?
  dateOfNotice      DateTime? @db.Date
  dueDate           DateTime? @db.Date
  subject           String    @db.Text
  status            String    @default("pending")
  engagementId      String?
  engagement        Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  fetchedAt         DateTime?
  rawData           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clientId])
  @@index([portal])
  @@index([status])
  @@index([dueDate])
}
