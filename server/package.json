{
  "name": "auditiq-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "tsx prisma/reset-db.ts",
    "db:reset:force": "tsx prisma/reset-db.ts -- --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "db:sync-permissions": "tsx scripts/sync-nav-permissions.ts",
    "db:repair-role-permissions": "tsx scripts/repair-role-permissions.ts",
    "db:repair-claim-approvals": "tsx scripts/repair-claim-manager-approvals.ts",
    "db:import-mkd-staff": "node scripts/import-mkd-employees.mjs",
    "db:backfill-roles": "node scripts/backfill-user-roles.mjs",
    "db:studio": "prisma studio",
    "portal:install": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:login": "node scripts/test-login.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.6",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "playwright": "^1.61.0",
    "prisma": "^6.9.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "zod": "^3.24.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
