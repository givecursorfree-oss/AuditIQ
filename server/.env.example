# Server
NODE_ENV=development
PORT=3001
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Database (MySQL — XAMPP MariaDB local, or AWS RDS for production)
DATABASE_URL="mysql://root@127.0.0.1:3306/auditiq"

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# File uploads (stored as MySQL BLOB — no filesystem needed)
MAX_FILE_SIZE_MB=10

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Password vault (AES-256) — use same value as seed for demo passwords
VAULT_ENCRYPTION_KEY=auditiq-dev-vault-key-for-seed-only

# Client document folders (onboarding)
CLIENT_STORAGE_ROOT=storage/clients

# Email (direct SMTP delivery — without SMTP, email attempts fail and are logged as failed)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Your CA Firm <notifications@your-domain.com>

# Client email verification — auto-skipped when SMTP_HOST is unset.
# Set to true only for local testing; use false in production after SMTP is configured.
SKIP_EMAIL_VERIFICATION=true

# Background scheduler interval (minutes)
SCHEDULER_INTERVAL_MIN=60
DIGEST_HOUR=9

# Document search (Typesense + Apache Tika — npm run search:up)
TYPESENSE_HOST=http://localhost:8108
TYPESENSE_API_KEY=auditiq-typesense-dev-key
TIKA_URL=http://localhost:9998
PADDLE_OCR_URL=http://localhost:8090
SEMANTIC_SEARCH_ENABLED=true
TYPESENSE_EMBEDDING_MODEL=ts/paraphrase-multilingual-mpnet-base-v2
SEMANTIC_SEARCH_ALPHA=0.45

# Google Drive sync (OAuth 2.0 — Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google-drive/callback

# Production hardening (default: off)
ALLOW_STAFF_REGISTRATION=false

# Government portal sync (GST / Income Tax / TRACES)
# PORTAL_SYNC_PROVIDER=playwright   # enable live scraping (default: none / not configured)
# PORTAL_SYNC_MOCK=true             # mock notices when provider=playwright (dev only)
# PORTAL_AUTOMATION_ENABLED=true    # required for Playwright login/scrape
# PORTAL_AUTOMATION_HEADLESS=false  # set false for captcha/OTP — headed browser window
# PORTAL_AUTOMATION_TIMEOUT_MS=90000
# Store portal credentials in Password Vault per client; run: cd server && npx playwright install chromium
