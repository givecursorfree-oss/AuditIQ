# ── AuditIQ Production Environment Variables ──

# MySQL
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# JWT — MUST be at least 32 characters
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Server
NODE_ENV=production
PORT=3001
CLIENT_URL=http://localhost
LOG_LEVEL=info

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Document search (docker compose services: typesense, tika)
TYPESENSE_API_KEY=auditiq-typesense-dev-key
TYPESENSE_HOST=http://typesense:8108
TIKA_URL=http://tika:9998

# Google Drive sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google-drive/callback

# Production hardening
CLIENT_URL=https://your-domain.com
VAULT_ENCRYPTION_KEY=change-me-32-chars-minimum-secret
ALLOW_STAFF_REGISTRATION=false
SKIP_EMAIL_VERIFICATION=false

# SMTP delivery (required for email)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=change-me-use-an-app-password
SMTP_FROM=Your CA Firm <notifications@your-domain.com>

# SSL/TLS (for certbot)
DOMAIN=yourdomain.com
