# Vercel frontend + VPS API only
# Copy on VPS: cp .env.api.example .env.api && nano .env.api

MYSQL_ROOT_PASSWORD=CHANGE_ME_long_random_mysql_password
JWT_SECRET=CHANGE_ME_at_least_32_characters_random_string
VAULT_ENCRYPTION_KEY=CHANGE_ME_another_32_char_minimum_secret

# Frontend on Vercel (primary app URL — used in emails/portal links)
CLIENT_URL=https://auditiq.mkdandeker.com
# Also allow the Vercel default *.vercel.app host (comma-separated)
CLIENT_ORIGINS=https://audit-iq-one.vercel.app

# API host on this VPS (nginx + certbot)
DOMAIN=api.mkdandeker.com

# Cookies: omit COOKIE_DOMAIN when using vercel.app (cross-site → host-only + SameSite=None).
# For custom domain only (auditiq + api under mkdandeker.com), you can set:
# COOKIE_DOMAIN=.mkdandeker.com
# COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SAMESITE=none

# Google Drive callback must hit the API host
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mkdandeker.com/api/integrations/google-drive/callback

ALLOW_STAFF_REGISTRATION=false
SKIP_EMAIL_VERIFICATION=false
MAX_FILE_SIZE_MB=25

# SMTP delivery (required for email)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=change-me-use-an-app-password
SMTP_FROM=Your CA Firm <notifications@your-domain.com>

# Document search (Typesense + Tika containers in docker-compose.api.yml)
# Must NOT be the typesense default "auditiq-typesense-dev-key" when semantic is on
TYPESENSE_API_KEY=CHANGE_ME_unique_typesense_api_key
SEMANTIC_SEARCH_ENABLED=true
