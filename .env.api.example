# Vercel frontend + VPS API split
# Copy on VPS: cp .env.api.example .env.api

MYSQL_ROOT_PASSWORD=CHANGE_ME_long_random_mysql_password
JWT_SECRET=CHANGE_ME_at_least_32_characters_random_string
VAULT_ENCRYPTION_KEY=CHANGE_ME_another_32_char_minimum_secret

# Frontend URL (your existing app host — NOT app.auditiq…)
CLIENT_URL=https://auditiq.mkdandeker.com

# Only used if you run docker-compose.api.yml alone; for kvm2 use API_DOMAIN below on client
DOMAIN=api.mkdandeker.com

# Prefer kvm2 all-in-one with:
#   DOMAIN=auditiq.mkdandeker.com
#   API_DOMAIN=api.mkdandeker.com

# Optional: share cookies across subdomains (leading dot)
# COOKIE_DOMAIN=.mkdandeker.com
# Only if frontend is on vercel.app (not recommended): COOKIE_SAMESITE=none

# Google Drive (callback must hit the API host)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.auditiq.mkdandeker.com/api/integrations/google-drive/callback

ALLOW_STAFF_REGISTRATION=false
SKIP_EMAIL_VERIFICATION=true
MAX_FILE_SIZE_MB=25
TYPESENSE_API_KEY=unused-on-api-only-set-any-non-default-key-here
