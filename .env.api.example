# Vercel frontend + VPS API only
# Copy on VPS: cp .env.api.example .env.api && nano .env.api

MYSQL_ROOT_PASSWORD=CHANGE_ME_long_random_mysql_password
JWT_SECRET=CHANGE_ME_at_least_32_characters_random_string
VAULT_ENCRYPTION_KEY=CHANGE_ME_another_32_char_minimum_secret

# Frontend on Vercel (your app domain)
CLIENT_URL=https://auditiq.mkdandeker.com

# API host on this VPS (nginx + certbot)
DOMAIN=api.mkdandeker.com

# Cookies shared across *.mkdandeker.com (recommended for Vercel app + api host)
COOKIE_DOMAIN=.mkdandeker.com

# Google Drive callback must hit the API host
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mkdandeker.com/api/integrations/google-drive/callback

ALLOW_STAFF_REGISTRATION=false
SKIP_EMAIL_VERIFICATION=true
MAX_FILE_SIZE_MB=25
TYPESENSE_API_KEY=unused-on-api-only-set-any-non-default-key-here
