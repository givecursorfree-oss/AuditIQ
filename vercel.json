{
  "buildCommand": "cd client && npm ci && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "installCommand": "echo skip-root-install",
  "env": {
    "VITE_API_URL": "https://api.mkdandeker.com"
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
